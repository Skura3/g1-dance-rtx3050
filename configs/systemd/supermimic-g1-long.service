[Unit]
Description=SuperMimic G1 continuous dance training with infrequent evaluation

[Service]
Type=simple
WorkingDirectory=/home/djs/supermimic
Environment=PYTHONUNBUFFERED=1
Environment=MUJOCO_GL=egl
Environment=G1_SUPERMIMIC_SOURCE=nju
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=SuperMimic --why=Continuous-G1-training /home/djs/supermimic/envs/training/.venv/bin/python /home/djs/supermimic/tools/finetune_nju.py --config /home/djs/supermimic/configs/g1_3050_nju_anchor.json --checkpoint /home/djs/supermimic/logs/train/reference_contact_anchor_ft2/ckpt_latest.pt --run-name reference_contact_anchor_long --keep-sampler --until-targets
ExecStopPost=/home/djs/supermimic/envs/training/.venv/bin/python /home/djs/supermimic/tools/finalize_long_training.py --run-dir /home/djs/supermimic/logs/train/reference_contact_anchor_long
Restart=no
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=900
StandardOutput=append:/home/djs/supermimic/logs/train/reference_contact_anchor_long/console.log
StandardError=inherit
